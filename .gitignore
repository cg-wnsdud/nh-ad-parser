# 전제로 하므로 제품 도구로 추적하지 않는다. 재조회는 stdout 전용 inspect script 사용.
tools/collect_serving_info.sh
tools/audit_serving_readonly.sh
tools/inspect_paddlex_pipeline_readonly.sh

