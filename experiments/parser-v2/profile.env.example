# 실제 주소·모델명은 이 파일에 쓰지 않는다. 저장소 루트 .env 또는 process 환경변수에 둔다.
PADDLEX_URL=http://127.0.0.1:18081/layout-parsing
# merge/threshold/unclip/text detection 및 모듈 on/off는 HTTP에서 보내지 않는다.
# spark-1118의 PP-StructureV3.yml 한 곳에서 관리한다.

GEMMA_URL=http://YOUR_FC87_GEMMA_HOST:4000/v1/chat/completions
GEMMA_MODEL=YOUR_GEMMA_MODEL_NAME

# parser-v2 입력 분기 기준
PARSER_V2_ASPECT_LIMIT=2.0
PARSER_V2_TILE_SPAN=1600
