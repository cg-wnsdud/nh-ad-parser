<View>
  <Header value="NH 광고물의 업무 단위와 소속 관계를 표시합니다. PP 클래스와 별도 프로젝트로 사용합니다." />
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false" />
  <RectangleLabels name="nh_structure" toName="image" strokeWidth="3" choice="single">
    <Label value="product_panel" background="#1565C0" />
    <Label value="product_title" background="#283593" />
    <Label value="benefit_group" background="#2E7D32" />
    <Label value="benefit_item" background="#689F38" />
    <Label value="condition" background="#F9A825" />
    <Label value="cta" background="#EF6C00" />
    <Label value="disclaimer" background="#6D4C41" />
    <Label value="legal_notice" background="#C62828" />
    <Label value="decorative" background="#757575" />
    <Label value="exclude" background="#BDBDBD" />
  </RectangleLabels>
  <Relations>
    <Relation value="belongs_to" />
    <Relation value="explains" />
    <Relation value="next" />
  </Relations>
  <TextArea name="review_note" toName="image" placeholder="상품 소속이나 경계가 애매한 이유" rows="3" />
</View>
