# 농협 Jupyter 서버에서 A안 + 선택적 KL API를 검토할 때 사용하는 예시다.
# 실제 주소, ID, 토큰은 복사한 .env에만 기록한다.

# KL/AWX API 앞단을 함께 실행할 때 ETL 백엔드를 선택한다.
NH_KL_AD_BACKEND=etl

# ETLwithLLM 공개 API 설정
ETL_BASE_URL=http://YOUR_ETLWITHLLM_HOST:PORT
ETL_WS_ID=PROVIDED_WORKSPACE_ID
ETL_AUTHOR=PROVIDED_AUTHOR
ETL_PROJECT_CONFIG={"extract_type":"dla"}
ETL_REQUEST_TIMEOUT_S=120
ETL_MAX_WAIT_S=1800
ETL_POLL_INTERVAL_S=5

# 인증 미들웨어가 켜진 경우 농협에서 제공받은 token 값만 설정한다.
# ETL_TOKEN=

# 농협 내부 vLLM OpenAI 호환 엔드포인트
GEMMA_URL=http://YOUR_VLLM_HOST:PORT/v1/chat/completions
GEMMA_MODEL=PROVIDED_VISION_MODEL_NAME
GEMMA_TIMEOUT_S=120
# 인증이 필요하다고 확인된 경우에만 설정한다. 현재 파이프라인 반영 전 계약 점검용이다.
# GEMMA_API_KEY=

# 초기 계약 검증은 영역 Reader/Judge를 끈 기준선으로 시작한다.
REGION_READING_MODE=off

# KL API 작업 디렉터리. Jupyter 서버에서 쓰기 가능한 절대 경로로 바꾼다.
PATH_TEMP=/path/to/writable/nh-ad-parser-runtime
KEEP_WORK_DIR=true
TIMEOUT=1800
