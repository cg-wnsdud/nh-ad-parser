# ── 개발용 OCR/VLM 서비스 ───────────────────────────────────────────
# 실행 환경의 실제 엔드포인트로 바꿔서 .env 로 복사해 쓸 것 — .env 는 gitignore 대상이라
# 여기(예시 파일, git 추적됨)에는 절대 실제 주소를 적지 않는다.
PADDLEX_URL=http://YOUR_PADDLEX_HOST:8081/layout-parsing
# ⚠ 실제 엔드포인트가 https 를 요구하면 프로토콜도 맞춰 바꿀 것 (http는 301 리다이렉트로 POST가 깨질 수 있음)
GEMMA_URL=http://YOUR_GEMMA_HOST:4000/v1/chat/completions
# 모델명은 게이트웨이가 노출하는 /models 응답과 정확히 일치해야 한다.
GEMMA_MODEL=YOUR_MODEL_NAME

# 타임아웃(초)
PADDLEX_TIMEOUT_S=180
GEMMA_TIMEOUT_S=120

# ── 선택적 Knowledge Lake/AWX 광고 API ────────────────────────────
# local: 기존 PaddleX/Gemma 경로, etl: 농협 ETLwithLLM에서 DLA 결과를 받아 후처리
NH_KL_AD_BACKEND=local
# PATH_TEMP를 생략하면 out/<오늘날짜>/kl-parser-runtime 아래에 작업 상태가 생긴다.
# PATH_TEMP=C:/project/work/temp
KEEP_WORK_DIR=false
TIMEOUT=1800

# NH_KL_AD_BACKEND=etl일 때만 필요. 실제 값은 농협에서 제공받아 .env에만 기록한다.
ETL_BASE_URL=http://YOUR_ETLWITHLLM_HOST
ETL_WS_ID=YOUR_WORKSPACE_ID
ETL_AUTHOR=YOUR_AUTHOR
ETL_PROJECT_CONFIG={"extract_type":"dla"}
# 가이드의 로그인 API를 쓰는 환경이면 Set-Cookie로 받은 token 값만 넣는다.
# 로그인 수행 자체는 농협 제공 범위이며 이 서비스가 계정/비밀번호를 보관하지 않는다.
# ETL_TOKEN=
# 별도 게이트웨이가 Authorization 헤더를 요구한다고 확인된 환경에서만 사용한다.
# ETL_AUTHORIZATION=
ETL_REQUEST_TIMEOUT_S=120
ETL_MAX_WAIT_S=1800
ETL_POLL_INTERVAL_S=5
