# ── 개발용 OCR/VLM 서비스 ───────────────────────────────────────────
# 실행 환경의 실제 엔드포인트로 바꿔서 .env 로 복사해 쓸 것 — .env 는 gitignore 대상이라
# 여기(예시 파일, git 추적됨)에는 절대 실제 주소를 적지 않는다.
PADDLEX_URL=http://YOUR_PADDLEX_HOST:8081/layout-parsing
# ⚠ 실제 엔드포인트가 https 를 요구하면 프로토콜도 맞춰 바꿀 것 (http는 301 리다이렉트로 POST가 깨질 수 있음)
GEMMA_URL=http://YOUR_GEMMA_HOST:4000/v1/chat/completions
# 모델명은 게이트웨이가 노출하는 /models 응답과 정확히 일치해야 한다.
GEMMA_MODEL=YOUR_MODEL_NAME

# 타임아웃(초)
PADDLEX_TIMEOUT_S=180
GEMMA_TIMEOUT_S=120
